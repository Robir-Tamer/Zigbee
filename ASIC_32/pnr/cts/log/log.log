###################################################################################
#########################################################
#### Section 5 : NDR ####
#########################################################
####################################################################################
##### CLock Source #####
create_routing_rule clk_network_NDR_root        -multiplier_spacing $clk_spacing_mult -multiplier_width $clk_width_mult
{clk_network_NDR_root}
##### Startinng From The First Level of Buffered Branches #####
create_routing_rule clk_network_NDR_internal    -multiplier_spacing $clk_spacing_mult -multiplier_width $clk_width_mult
{clk_network_NDR_internal}
##### From the Last Level of Buffers to Sinks (Leaf) #####
create_routing_rule clk_network_NDR_leaf -multiplier_spacing 1 -multiplier_width 1
{clk_network_NDR_leaf}
#Root
set_clock_routing_rules -net_type           root                         -clocks             $clock_names                         -rules              clk_network_NDR_root                         -max_routing_layer  M7                         -min_routing_layer  M6 
1
#Internal
set_clock_routing_rules -net_type           internal                         -clocks             $clock_names                         -rules              clk_network_NDR_internal                         -max_routing_layer  M6                         -min_routing_layer  M3
1
#Leaf
set_clock_routing_rules -net_type           sink                         -clocks             $clock_names                         -rules              clk_network_NDR_leaf                         -max_routing_layer  M3                         -min_routing_layer  M1
1
