##### Project Name #####
set top_module "zigbee"
zigbee
set proj_path "/home/ICer/Desktop/shared_folder/ROBO/Zigbee/ASIC_32"
/home/ICer/Desktop/shared_folder/ROBO/Zigbee/ASIC_32
##### Library Type #####
set lib_typ "syn"
syn
set SSLIB "/home/ICer/Desktop/shared_folder/32nm_lib/dbs/hvt/saed32hvt_ss0p75vn40c.db"
/home/ICer/Desktop/shared_folder/32nm_lib/dbs/hvt/saed32hvt_ss0p75vn40c.db
set rate "fast"
fast
if {$rate == "fast"} {
       set param "F"
} elseif {$rate == "slow"} {
       set param "S"
} elseif {$rate == "hybrid"} {
       set param "H"
}
F
##### Design Library #####
set dlib_dir "${proj_path}/pnr/design_lib/outputs/${rate}"
/home/ICer/Desktop/shared_folder/ROBO/Zigbee/ASIC_32/pnr/design_lib/outputs/fast
###### Ideal Ports #####
set fun_clk_port "clk"
clk
set fun_srst_port "rst_n"
rst_n
set ideal_network [list $fun_clk_port  $fun_srst_port]
clk rst_n
set removed_ideal_network [list $fun_srst_port]
rst_n
set clock_names [list clk]
clk
##### Layers #####
set hm_top M9
M9
set vm_top M8
M8
##### Stages #####
set prev_stage      "placement"
placement
set current_stage   "cts"
cts
##### NDR #####
set clk_spacing_mult 2
2
set clk_width_mult 2
2
set max_fanout 5
5
set max_wire_l 100
100
